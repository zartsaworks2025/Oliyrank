# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
# Local: run `npx prisma dev` and paste the postgres:// URL it prints.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/oliyrank"

# Connections per server process (default 10). Use 1 with the local `prisma dev`
# server, which stalls when a build opens many connections at once.
DATABASE_POOL_MAX=1

# Build workers (default: all CPUs). Use 1 with the local `prisma dev` server.
# NEXT_BUILD_CPUS=1
